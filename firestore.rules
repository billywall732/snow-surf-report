// Who may read and write saved settings in Firestore. Paste this into
// Firebase console -> Firestore Database -> Rules, then Publish.
//
// Each person's settings live at users/<their id>. Only that person, signed in,
// can read, change or delete their own record, and the email saved must be their
// real Google email. (The GitHub Action uses a service account, which is allowed
// to read everyone's record to send emails; these rules don't apply to it.)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'name', 'emailAlerts', 'settings', 'profile', 'pins', 'rider', 'updatedAt', 'lastSentDate']);
    }
    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
